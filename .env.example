# Kalshi prediction market exchange
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=

# Anthropic (Claude LLM)
ANTHROPIC_API_KEY=

# Tavily (web search)
TAVILY_API_KEY=

# NewsAPI
NEWSAPI_KEY=

# Reddit (no credentials needed — uses public JSON API)
# Optional: override the User-Agent sent with requests (default: freqpred/0.1)
# REDDIT_USER_AGENT=freqpred/0.1

# Truth Social (optional — required if ingestion.truthsocial.enabled: true)
TRUTHSOCIAL_USERNAME=
TRUTHSOCIAL_PASSWORD=

# Database
DATABASE_URL=postgresql+asyncpg://freqpred:freqpred@localhost:5432/freqpred

# Redis
REDIS_URL=redis://localhost:6379

# Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Live trading guard (must be explicitly set to enable live orders)
LIVE_TRADING_ENABLED=false
